pipeline {
  agent any

  environment {
    CORONA_SPDX_FILE_PATH = 'spring-petclinic.spdx.json'
  }

  stages {
    stage('Generate SBOM') {
      steps {
        script {
          echo "Initial CORONA_SPDX_FILE_PATH = ${env.CORONA_SPDX_FILE_PATH}"

          def today = sh(script: 'date +%Y.%m.%d', returnStdout: true).trim()
          def base = env.CORONA_SPDX_FILE_PATH.replaceAll(/\.json$/, '')
          def modifiedFileName = "${base}.${env.BUILD_NUMBER}.${today}.json"

          // Export it so it persists to next stage
          env.CORONA_SPDX_FILE_PATH = modifiedFileName

          echo "Updated CORONA_SPDX_FILE_PATH: ${env.CORONA_SPDX_FILE_PATH}"

          // Use it in the shell
          sh "syft scan dir:. --exclude ./src/test -o spdx-json@2.3 > ${env.CORONA_SPDX_FILE_PATH}"
        }
      }
    }

    stage('Push SBOM to Corona') {
      steps {
        script {
          echo "CORONA_SPDX_FILE_PATH in Push stage: ${env.CORONA_SPDX_FILE_PATH}"

          // Just demonstrating the value is preserved
          sh "ls -l ${env.CORONA_SPDX_FILE_PATH}"

          // Dummy command simulating Docker usage
          sh """
            echo 'Would run Docker with file: ${env.CORONA_SPDX_FILE_PATH}'
          """
        }
      }
    }
  }
}
