pipeline {
  agent any

  environment {
    BASE_JSON_FILE = 'spring-petclinic.spdx.json'
  }

  stages {
    stage('Generate SBOM') {
      steps {
        script {
          echo "Initial BASE_JSON_FILE = ${env.BASE_JSON_FILE}"

          def today = sh(script: 'date +%Y.%m.%d', returnStdout: true).trim()
          def baseName = env.BASE_JSON_FILE.replaceAll(/\.json$/, '')
          def modifiedName = "${baseName}.${env.BUILD_NUMBER}.${today}.json"

          echo "Generated modifiedName = ${modifiedName}"

          // Save to another env variable for this build lifetime
          env.CORONA_SPDX_FILE_PATH = modifiedName

          // Create the SBOM file with Syft
          sh "syft scan dir:. --exclude ./src/test -o spdx-json@2.3 > '${modifiedName}'"
        }
      }
    }

    stage('Push SBOM to Corona') {
      steps {
        script {
          def filename = env.CORONA_SPDX_FILE_PATH
          echo "CORONA_SPDX_FILE_PATH in push stage: ${filename}"

          sh "ls -l '${filename}'"
          sh "echo 'Would run Docker with file: ${filename}'"
        }
      }
    }
  }
}
