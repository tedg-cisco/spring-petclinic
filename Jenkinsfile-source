pipeline {
  agent any

  // Added for upload_spdx_to_corona
  environment {
    CORONA_PAT = credentials('corona-pat')
    CORONA_HOST = 'corona.cisco.com'
    CORONA_USERNAME = 'tedgcisco.gen'
    CORONA_ENGINEERING_CONTACT = 'tedg-corona-eng-mailer'
    CORONA_SECURITY_CONTACT = 'tedg-corona-sec-mailer'
    // These env variables specify the Corona Product/Release/Image 
    // and locally created SPDX file to upload
    CORONA_PRODUCT_NAME = 'spring-petclinic SPDX Upload - TEST'
    CORONA_RELEASE_VERSION = '1.1'
    CORONA_IMAGE_NAME = 'spring-petclinic.spdx.json' + ".${env.BUILD_NUMBER}"
    CORONA_SPDX_FILE_PATH = 'spring-petclinic.spdx.json'
  }

  stages {
    stage('build') {
      steps {
        sh './mvnw clean package -Dcheckstyle.skip'
      }
    }
    stage('Generate SBOM') {
      steps {
        script {
          echo "Initial CORONA_SPDX_FILE_PATH = ${env.CORONA_SPDX_FILE_PATH}"

          def today = sh(script: 'date +%Y.%m.%d', returnStdout: true).trim()
          def baseName = env.CORONA_SPDX_FILE_PATH.replaceAll(/\.json$/, '')
          def modifiedName = "${pwd()}/${baseName}_${today}_${env.BUILD_NUMBER}.json"

          echo "Generate SBOM modifiedName = ${modifiedName}"

          // Save to another env variable for this build lifetime
          env.CORONA_SPDX_FILE_PATH = modifiedName

          // Create the SBOM file with Syft
          sh "syft scan dir:. --exclude ./src/test -o spdx-json@2.3 > '${modifiedName}'"
          sh "ls -alt '${modifiedName}'"
        }
      }
    }

    // Added for upload_spdx_to_corona
    stage('Push SBOM to Corona') {
      steps {
        sh 'docker pull containers.cisco.com/tedg/upload_spdx'

        script {
          def fullPath = env.CORONA_SPDX_FILE_PATH
          def fileNameOnly = fullPath.tokenize('/').last()
          def workspaceDir = pwd()

          echo "CORONA_SPDX_FILE_PATH in push stage: ${fullPath}"
          echo "SBOM filename only: ${fileNameOnly}"
          echo "Workspace directory: ${workspaceDir}"
  
          sh """
            docker run \
                -e CORONA_PAT="$CORONA_PAT" \
                -e CORONA_HOST="$CORONA_HOST" \
                -e CORONA_USERNAME="$CORONA_USERNAME" \
                -e CORONA_ENGINEERING_CONTACT="$CORONA_ENGINEERING_CONTACT" \
                -e CORONA_SECURITY_CONTACT="$CORONA_SECURITY_CONTACT" \
                -e CORONA_PRODUCT_NAME="$CORONA_PRODUCT_NAME" \
                -e CORONA_RELEASE_VERSION="$CORONA_RELEASE_VERSION" \
                -e CORONA_IMAGE_NAME="$CORONA_IMAGE_NAME" \
                -e CORONA_SPDX_FILE_PATH="$fullPath" \
                -v \$(PWD)/$fullPath:/app/$fullPath \
                containers.cisco.com/tedg/upload_spdx 
          """
        }
      }
    }
  }
}
