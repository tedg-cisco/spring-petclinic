pipeline {
  agent any

  // Added for upload_spdx_to_corona
  environment {
    CORONA_PAT = credentials('corona-pat')
    CORONA_HOST = 'corona.cisco.com'
    CORONA_USERNAME = 'tedgcisco.gen'
    CORONA_ENGINEERING_CONTACT = 'tedg-corona-eng-mailer'
    CORONA_SECURITY_CONTACT = 'tedg-corona-sec-mailer'
    // These env variables specify the Corona Product/Release/Image 
    // and locally created SPDX file to upload
    CORONA_PRODUCT_NAME = 'Test - spring-petclinic SPDX Upload'
    CORONA_RELEASE_VERSION = '1.0.0'
    CORONA_SPDX_FILE_NAME = 'spring-petclinic.spdx.json'
    // CORONA_IMAGE_NAME created in Generate SBOM stage based on
    // filename + date + build number
    CORONA_SPDX_FILENAME_DATE_BUILD = ' '
    CORONA_IMAGE_NAME = ' '
  }

  stages {
    stage('build') {
      steps {
        sh './mvnw clean package -Dcheckstyle.skip'
      }
    }
    stage('Generate SBOM') {
      steps {
        script {
          // Extract date in YYYY.MM.DD format
          export TODAY=$(date +%Y.%m.%d)
          echo "TODAY=${TODAY}"
  
          // Extract base name (without extension)
          export BASE_NAME=$(basename "${CORONA_SPDX_FILE_NAME}" .json)
          echo "BASE_NAME=${BASE_NAME}"
  
          echo "BASE_NAME=${BASE_NAME}, TODAY=${TODAY}, BUILD_NUMBER=${BUILD_NUMBER}"
  
          // Construct the full name with date and build number
          export CORONA_SPDX_FILENAME_DATE_BUILD="${BASE_NAME}_${TODAY}_${BUILD_NUMBER}.json"
          echo "CORONA_SPDX_FILENAME_DATE_BUILD=${CORONA_SPDX_FILENAME_DATE_BUILD}"
  
          // Construct the full name with date and build number
          export CORONA_IMAGE_NAME=${CORONA_SPDX_FILENAME_DATE_BUILD}
          echo "CORONA_IMAGE_NAME=${CORONA_IMAGE_NAME}"
  
          syft scan dir:. --exclude ./src/test -o spdx-json@2.3  > $(PWD)/$CORONA_SPDX_FILENAME_DATE_BUILD
          ls -alt $(PWD)/$CORONA_SPDX_FILENAME_DATE_BUILD
        }
      }
    }

    // Added for upload_spdx_to_corona
    stage('Push SBOM to Corona') {
      steps {
        sh 'docker pull containers.cisco.com/tedg/upload_spdx'
        sh '''
          docker run -d \
              -e CORONA_PAT="$CORONA_PAT" \
              -e CORONA_HOST="$CORONA_HOST" \
              -e CORONA_USERNAME="$CORONA_USERNAME" \
              -e CORONA_ENGINEERING_CONTACT="$CORONA_ENGINEERING_CONTACT" \
              -e CORONA_SECURITY_CONTACT="$CORONA_SECURITY_CONTACT" \
              -e CORONA_PRODUCT_NAME="$CORONA_PRODUCT_NAME" \
              -e CORONA_RELEASE_VERSION="$CORONA_RELEASE_VERSION" \
              -e CORONA_IMAGE_NAME="$CORONA_IMAGE_NAME" \
              -e CORONA_SPDX_FILENAME_DATE_BUILD="$CORONA_SPDX_FILENAME_DATE_BUILD" \
              -v \$(PWD)/$CORONA_SPDX_FILENAME_DATE_BUILD:/app/$CORONA_SPDX_FILENAME_DATE_BUILD \
              containers.cisco.com/tedg/upload_spdx 
        '''
      }
    }
  }
}
